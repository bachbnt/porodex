{
  "name": "porodex",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Porodex — a Hextech-styled companion for League of Legends and Teamfight Tactics: champions, items, traits, a team builder and quizzes.",
  "scripts": {
    "dev": "nuxt dev",
    "predev": "npm run sync",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "pregenerate": "npm run sync",
    "preview": "firebase emulators:start --only hosting",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "sync": "node scripts/sync-data.mjs",
    "deploy:firebase": "npm run generate && firebase deploy --only hosting",
    "deploy:local": "zsh scripts/deploy.command"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.11.4",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^0.11.2",
    "@tailwindcss/vite": "^4.1.11",
    "@vueuse/core": "^13.5.0",
    "@vueuse/nuxt": "^13.5.0",
    "nuxt": "^4.6.4",
    "pinia": "^3.0.3",
    "tailwindcss": "^4.1.11",
    "vue": "^3.5.18",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.0.4"
  }
}
